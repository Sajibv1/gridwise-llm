# Copy this file to .env and set values locally. Never commit real secret values.
OPENAI_API_KEY=

# Use a structured-output-capable model available to your account.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_REASONING_EFFORT=low

# At most two model calls occur (the second is semantic repair), keeping ample
# margin below the API's 30-second deadline. SDK HTTP retries stay disabled because
# a provider Retry-After can otherwise exceed that deadline.
LLM_TIMEOUT_SECONDS=7
LLM_MAX_RETRIES=0
LLM_SEMANTIC_RETRIES=1
LOG_LEVEL=INFO
