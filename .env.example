# Copy this file to .env and set values locally. Never commit real secret values.
OPENAI_API_KEY=

# Use a structured-output-capable model available to your account.
OPENAI_MODEL=gpt-4.1-mini

# Keep provider calls bounded so the endpoint reliably meets its 30-second limit.
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=1
LOG_LEVEL=INFO
